# ─────────────────────────────────────────────────────────────────────────────
# 后端环境变量样例
#
# 复制为 backend/.env 后按需修改。
# ⚠️ backend/.env 已被 .gitignore 排除，**绝不要**把真实密钥提交入库。
#
# 变量名全部大写，与 `backend/app/core/config.py` 的 Settings 字段一一对应
# （Pydantic Settings 会自动忽略环境变量名的大小写差异）。
# ─────────────────────────────────────────────────────────────────────────────


# ── 数据库 ───────────────────────────────────────────────────────────────────
# SQLite（默认）。生产环境可换 PostgreSQL：
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/perf.db

# 启动时是否自动建表（仅建议开发环境开启；生产用 Alembic 迁移）。
AUTO_CREATE_TABLES=true


# ── 鉴权 ─────────────────────────────────────────────────────────────────────
# ⚠️ **必填**。用于签发/校验登录 token 的 HMAC 密钥。
#    生产环境必须是高熵随机值（可用 `python -c "import secrets;print(secrets.token_urlsafe(48))"` 生成）。
#    留空会导致启动直接失败（弱密钥静默上线是更糟的选择）。
AUTH_TOKEN_SECRET=

# 是否启用严格鉴权模式。生产环境必须为 true。
SECURE_AUTH=true


# ── AI / 智能体服务 ──────────────────────────────────────────────────────────
AGENT_SERVICE_URL=http://127.0.0.1:8800

# ⚠️ 与 agent-service 侧的 AGENT_SHARED_SECRET **必须一致**。
#    留空时 agent-service **拒绝启动**（不再默认免鉴权，见 R12）。
#    生成方式：python backend/scripts/rotate_agent_secret.py
AGENT_SHARED_SECRET=

# 评分模型。MODEL_MODE=RULE_ONLY 时只用确定性规则，不调用外部模型。
MODEL_NAME=default
MODEL_MODE=RULE_ONLY
# 评分口径（交给规则引擎 / AI 复核共同遵守）。
RATING_POLICY=balanced


# ── 考勤展示 ────────────────────────────────────────────────────────────────
# 考勤同步的异常记录只作参考，**不进算分集**。留空表示不展示考勤。
ATTENDANCE_DISPLAY_TYPES=
# 绩效数据的「截至时间」展示口径。
SHOW_AS_OF=


# ── 飞书组织架构同步 ────────────────────────────────────────────────────────
# 应用凭证。留空时同步端点会明确报「未配置」，不会静默失败。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_ID=

# ── 飞书事件回调（webhook）凭据 ─────────────────────────────────────────────
# 来自开发者后台「事件与回调 > 加密策略」页面。
#
# ⚠️ **Encrypt Key 配没配，决定了飞书推送的形态**：
#
#   未配 Encrypt Key → 飞书推明文 JSON，比对 Verification Token 即可
#   已配 Encrypt Key → 飞书推 {"encrypt": "<base64密文>"}，
#                       **必须先解密**才能拿到事件内容与 Token，
#                       同时启用 SHA-256 签名校验（X-Lark-Signature）
#
# 两个都留空时 `/v1/feishu/approval/events` 返回 503（不放行）。
FEISHU_ENCRYPT_KEY=
FEISHU_APPROVAL_WEBHOOK_TOKEN=

# ── 飞书机器人（FS-3 工作台会话填表）──────────────────────────────────────
# ⚠️ **Verification Token 是「应用级」的 —— 一个飞书应用只有一个**。
#
#    官方原文（飞书开放平台「将事件发送至开发者服务器」）：
#    「Verification Token 是应用的验证标识。开发者后台会为应用自动生成
#     Verification Token」；且「每个应用只能配置一个请求地址，
#     该应用订阅的所有事件都会发送到该请求地址」。
#
#    ⇒ 审批 / 通讯录 / 机器人**必然共用**同一个 Token。
#    ⇒ 想让机器人有独立 Token，只有「**新建一个飞书应用**」这一条路。
#
#    ⇒ **隔离靠端点路径 + 事件类型白名单，不靠 Token**：
#       /v1/feishu/bot/events      只处理 im.message.receive_v1 + card.action.trigger
#       /v1/feishu/approval/events 只处理 approval.approval.updated_v4
#       /v1/feishu/contact/events  只处理 contact.*
#       排障时看**日志里的事件类型**分辨链路。
#
# 本项**留空 → 自动回退用 FEISHU_APPROVAL_WEBHOOK_TOKEN**（同一应用下二者相同），
# 避免「配了一个漏配另一个」导致 503。
# 独立应用部署时，填**该应用自己的** Token 即可。
# 两者都为空 → `/v1/feishu/bot/events` 返回 503（不放行）。
FEISHU_BOT_EVENT_TOKEN=
# 机器人会话有效期（分钟）。超过则视为过期，员工重新发起即可。
FEISHU_BOT_SESSION_TTL_MINUTES=120
# 机器人是否启用。关闭时 bot/events 只做握手，不处理业务事件。
FEISHU_BOT_ENABLED=true

# ── 飞书 OAuth（网页免登，FS-1 / FS-2）─────────────────────────────────────
# ⚠️ 全部留空时 `/v1/feishu/auth/url` 返回 503（不放行）——
#    与「审批/通讯录 webhook 未配 Token 就 503」同一套安全语义：
#    宁可明确失败，也不要留一个半残的免登入口。
#
# 授权成功后的回调地址（逗号分隔多个）。
# ⚠️⚠️ 必须与飞书后台「网页应用 > 授权页面 > 重定向 URL」**逐字一致**，
#      否则飞书会直接拒绝授权 —— 且**错误只在飞书侧**，本地日志看不到。
#    （逐字一致的 7 个差异点与 IT 配合步骤见 docs/17 §2.5）
#
# 本地开发示例（Vite dev server 的端口是 5180）：
# FEISHU_OAUTH_REDIRECT_URIS=http://localhost:5180/feishu/callback
#
# 生产示例（追加正式域名，用逗号分隔）：
# FEISHU_OAUTH_REDIRECT_URIS=https://perf.example.com/feishu/callback,http://localhost:5180/feishu/callback
FEISHU_OAUTH_REDIRECT_URIS=

# state 签名密钥。留空时回退到 AUTH_TOKEN_SECRET。
# ⚠️ 建议独立配置 —— 密钥隔离：登录 token 泄露不应波及 state 防重放。
FEISHU_OAUTH_STATE_SECRET=

# state 有效期（秒）。建议 600（10 分钟）。
FEISHU_OAUTH_STATE_TTL_SECONDS=600

# 申请的 OAuth scope（逗号分隔）。免登只需读用户基本信息；
# ⚠️ 多申请会被飞书后台审核卡住。
FEISHU_OAUTH_SCOPES=contact:user.base:readonly

# ⚠️⚠️ **定时同步开关**（R8）—— 这是最容易被漏掉的一项 ⚠️⚠️
#
# 默认 **false**：不打开就**永远不会有定时同步**，
# 哪怕上面凭证配齐了、代码写好了 —— `start_scheduler()` 会直接 return。
#
# 打开后：服务启动即跑一次全量/增量同步，之后按固定间隔执行。
# FS-4 只投递三项同时匹配的一条发件箱记录。缺任一项时停止投递。
NOTIFICATION_ENABLED=false
NOTIFICATION_CANARY_EMPLOYEE_ID=
NOTIFICATION_CANARY_SCENE=
NOTIFICATION_CANARY_OUTBOX_ID=
FEISHU_SYNC_ENABLED=false

# 定时同步间隔（秒）。最小 60 秒（低于此值配置校验会直接报错）。
# ⚠️ **仅在「每日固定时刻」模式（下一项）留空时生效**。
FEISHU_SYNC_INTERVAL_SECONDS=3600

# ⚠️⚠️ **每日固定时刻同步**（2026-11-25）—— 「每天早上 8 点自动同步」。
#
# ✅ 配成 `08:00` ⇒ **每天早上 8:00 自动同步组织架构**（业务时刻）。
# ✅ 留空 ⇒ 退回上面的间隔模式（每 N 小时一次）。
#
# ❌ **不要用「把 FEISHU_SYNC_INTERVAL_SECONDS 设成 86400」来代替**：
#    间隔模式的触发时刻是「上次跑完 + 间隔」，**会随服务重启漂移** ——
#    今天 8:00 跑过，明天服务 9 点重启就变成明天 9:00，之后永远 9:00。
#    需求「每天早上 8 点」是**日历时刻**，必须用本项。
#
# 📌 时刻用的是**服务器本地时间**，部署时注意时区（国内云一般为 UTC+8）。
FEISHU_SYNC_DAILY_TIME=08:00

# 每日模式的「到点窗口」宽度（分钟）。
# ⚠️ 不是「8:00:00 那一刻」而是「8:00 ~ 8:00+窗口」——
#    服务在 8 点后启动、或调度线程那一刻卡住，都不会漏跑当天同步。
FEISHU_SYNC_DAILY_WINDOW_MINUTES=10


# ── 同步失败告警（R12 / 同步可观测性）────────────────────────────────────────
# 同一 dedup_key 在此窗口内不重复告警（秒）。
FEISHU_SYNC_ALERT_SUPPRESS_SECONDS=1800
# 连续多少轮定时同步失败后触发「调度器连续失败」告警。
FEISHU_SYNC_ALERT_CONSECUTIVE_FAILURES=3
# 单条失败记录的积压告警阈值。
FEISHU_SYNC_ALERT_ERROR_BACKLOG_THRESHOLD=10

# 飞书 IM 告警接收人。**留空则只入库、不发外部通知**（不会报错）。
FEISHU_SYNC_ALERT_RECEIVER_ID=
# 接收人 ID 类型：open_id / user_id / chat_id。
FEISHU_SYNC_ALERT_RECEIVER_TYPE=chat_id


# ── 离职员工状态判定口径（⚠️ 业务待确认）────────────────────────────────────
#
# 以下三项的默认值是**当前代码的实际行为**，不是业务已确认的结论。
# 业务确认后只需改环境变量，无需改代码。
#
# is_unjoin（未加入企业）是否按离职处理。
#   false = 按 inactive（未入职，可自动恢复，当前默认）
#   true  = 按 exited（视为已离开，需人工复职）
FEISHU_SYNC_UNJOIN_AS_EXITED=false
# 离职是否禁用账号（同时 token_version 递增，使已签发 token 失效）。
FEISHU_SYNC_EXITED_DISABLES_ACCOUNT=true
# 冻结/未激活是否禁用账号。
FEISHU_SYNC_INACTIVE_DISABLES_ACCOUNT=true

# 飞书排班同步（2026-11-27）：每天同步当月+下月排班
FEISHU_WORKDAY_SYNC_ENABLED=false
FEISHU_WORKDAY_SYNC_HOUR=2
