# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.db
*.sqlite
*.sqlite3
backend/data/
data/

# Node
node_modules/
frontend/dist/
dist/
*.tsbuildinfo
# Vite 依赖预构建缓存（本地生成，不进版本库）
frontend/.vite/

# 日志与临时文件
*.log
.tmp_*
*.tmp
# ⚠️ dev server / 探针脚本的 stderr 输出 —— 运行时产物，不该进版本库。
#    （这些文件会被进程持续写入，导致 git rebase/checkout 反复失败：
#      "local changes would be overwritten by checkout"）
*.err

# 本地密钥与配置（绝不入库）
.env
.env.*
!.env.example
*.local

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store

# ⚠️ feishu/ —— 本地飞书 Go SDK 试验目录（IDE scratch project）。
#
# 它不是 Python 代码：`feishu/feishu.py` 实际是 **Go 源码**
# （`package main` + larksuite/oapi-sdk-go），被误存成了 .py 扩展名。
#
# 后果：
# 1. `ruff check .` 会在上面报 55 个语法错误 → CI 直接红；
# 2. 里面有硬编码的飞书 App ID / App Secret。
#
# 所以整目录既不入版本库，也不进静态检查范围。
feishu/

# CI 本地产物
.coverage
coverage.xml
htmlcov/

# 手工验证用的临时产物
# （R6 闭环验证脚本生成的证据文件；前端 public/ 下的同名副本同理）
_r6_evidence/
frontend/public/_r6_evidence/
frontend/public/*.pdf
frontend/public/*.docx

# 后端一次性调试脚本（下划线开头）
backend/_*.py
# ⚠️ backend/scripts/ 下的下划线脚本同理 —— 它们是一次性排查产物，
#    不该进版本库，也不该被 ruff 当成待修代码。
backend/scripts/_*.py

# Playwright MCP 运行产物
.playwright-mcp/
