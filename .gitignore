# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.db
*.sqlite
*.sqlite3
backend/data/
data/

# Node
node_modules/
frontend/dist/
dist/
*.tsbuildinfo

# 日志与临时文件
*.log
.tmp_*
*.tmp
# ⚠️ dev server / 探针脚本的 stderr 输出 —— 运行时产物，不该进版本库。
#    （这些文件会被进程持续写入，导致 git rebase/checkout 反复失败：
#      "local changes would be overwritten by checkout"）
*.err

# 本地密钥与配置（绝不入库）
.env
.env.*
!.env.example
*.local

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store

# CI 本地产物
.coverage
coverage.xml
htmlcov/

# 手工验证用的临时产物
# （R6 闭环验证脚本生成的证据文件；前端 public/ 下的同名副本同理）
_r6_evidence/
frontend/public/_r6_evidence/
frontend/public/*.pdf
frontend/public/*.docx

# 后端一次性调试脚本（下划线开头）
backend/_*.py
